# ═══════════════════════════════════════════
# Zero Bot Platform — Environment Variables
# ═══════════════════════════════════════════

# ── Telegram ──
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
IA_MOTHER_BOT_TOKEN=your_ia_mother_bot_token

# ── TON ──
TON_API_KEY=your_toncenter_api_key
TON_NETWORK=mainnet
TON_CENTER_URL=https://toncenter.com/api/v2
IAM_COIN_MASTER_ADDRESS=EQA...  # адрес Jetton Master контракта
NFT_COLLECTION_ADDRESS=EQA...  # адрес NFT коллекции паспортов
PLATFORM_TON_WALLET=EQA...     # кошелёк платформы

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Langflow ──
LANGFLOW_PASSWORD=admin123

# ── AI Providers (for personalities) ──
OPENROUTER_API_KEY=your_openrouter_key
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key
LLM_MODEL=deepseek/deepseek-v4-flash-0731

# ── Хелпер (публичный бот в группе) ──
# Токен от BotFather
HELPER_BOT_TOKEN=
HELPER_BOT_NAME=Хелпер
# Тот же чат, что выгружает Дервалер
# Личность хелпера (ia по умолчанию)
HELPER_PERSONALITY=ia

# ── Дервалер (архивариус чата) ──
# ВАЖНО: пользовательская сессия администратора = пароль. Не коммитить.
# Создать: python -m services.dervaler.bootstrap_session
DERVALER_SESSION=
# Какой чат выгружать (id или @username, например -1001234567890)
HELPER_CHAT_ID=
# Ограничить выгрузку только этими чатами (пусто = только HELPER_CHAT_ID)
DERVALER_ALLOWED_CHAT_IDS=
# Куда слать статус в личку (0 = не слать)
DERVALER_ADMIN_ID=0
DERVALER_BATCH_SIZE=500
DERVALER_WAIT_TIME=1
DERVALER_LIVE=true

# ── Bot containers ──
PERSONALITY=ia
# Optional: restrict a helper bot to these chats (comma separated).
# Empty = no restriction.
ALLOWED_CHAT_IDS=
# Container limits per bot
BOT_MEM_LIMIT=512m
BOT_CPU_QUOTA=100000

# ── Core API (обязательно) ──
# Общий секрет для вызовов между сервисами. Core API без него не стартует.
# Сгенерировать: openssl rand -hex 32
CORE_API_TOKEN=

# Пароль Redis. Пустое значение = без пароля (только для локальной разработки).
REDIS_PASSWORD=

# ── Чат отладки ──
# Скрепка шлёт сюда новые баг-репорты и инциденты. Пусто = уведомлений нет,
# отчёты останутся только в базе.
# Токен — отдельный бот от BotFather; ADMIN_CHAT_ID — id чата или группы.
SKREPKA_BOT_TOKEN=
ADMIN_CHAT_ID=

# ── Кто может создавать ботов ──
# Создание бота поднимает контейнер на хосте. По умолчанию доступ закрыт:
# разрешены только OWNER_ID и перечисленные здесь id.
ALLOWED_CREATOR_IDS=
# true = разрешить создание ботов всем (публичная платформа). Осознанно.
ALLOW_PUBLIC_BOT_CREATION=false

# ── Шифрование кошельков ──
# Приватные ключи TON хранятся зашифрованными этим ключом. Без него операции
# с кошельками отклоняются (раньше ключи лежали в базе открытым текстом).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WALLET_ENCRYPTION_KEY=
